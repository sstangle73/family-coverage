<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 and later draw every app edge to edge, behind the system bars. Each screen has its own heading, so
         there's no title bar (it overlapped the top of the screen), and Ui.show keeps the content inside the bars.
         The bars' icons are dark on the light background; values-night has light ones. -->
    <style name="Theme.FamilyCoverage" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
